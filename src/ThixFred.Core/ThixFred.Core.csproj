<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Models, business layer (static classes), infrastructure and the native parts of the launcher (program index, icons,
    global hotkey, processes, terminal, scripts) for Windows and macOS. No UI. Windows-only code is guarded by
    OperatingSystem.IsWindows() or [SupportedOSPlatform("windows")].
    MatCloud/ is a COPY of the contract of MatCloud (routes, DTOs, MatCloudClient): never edited here, copied again with
    node ../MatCloud/tools/contract-copy.js src/ThixFred.Core (see CLAUDE.md).
  -->
  <PropertyGroup>
    <TargetFramework>$(DesktopTargetFramework)</TargetFramework>
    <RootNamespace>ThixFred.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixFred.Tests" />
    <InternalsVisibleTo Include="ThixFred" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

</Project>
